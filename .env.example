# Copy this file to `.env` or export variables in your shell before running.

# RootData API key used by `scripts/fetch-rootdata.py`
ROOTDATA_API_KEY=replace-with-your-rootdata-key

# BlockBeats API key used by `scripts/fetch-blockbeats.py`
BLOCKBEATS_API_KEY=replace-with-your-blockbeats-key

# Surf API key used by `scripts/fetch-surf.py`
SURF_API_KEY=replace-with-your-surf-key

# Optional GitHub token used by `scripts/fetch-github.py` for higher rate limits
GITHUB_TOKEN=replace-with-your-github-token
